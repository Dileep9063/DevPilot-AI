# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM providers (set at least one; others are used as automatic fallback) ---
OPENROUTER_API_KEY=your-openrouter-key-here
GEMINI_API_KEY=your-gemini-api-key-here
HF_TOKEN=your-huggingface-token-here
# Order tried, comma separated (default shown):
# LLM_PROVIDER_ORDER=openrouter,gemini,huggingface
# LLM_RETRIES=1

# --- LangGraph checkpoints (PostgreSQL; tables are created automatically) ---
LANGGRAPH_POSTGRES_URI=postgresql://postgres:your-password@127.0.0.1:5432/devpilot_checkpoints

# --- GitHub: fine-grained token with Contents + Pull requests (read/write) ---
GITHUB_TOKEN=your-github-token-here

# --- GitHub App mode (optional; see docs/GITHUB_APP_SETUP.md) ---
# When all of these are set, each user connects their own GitHub account and
# GITHUB_TOKEN is no longer needed. Leave empty to keep using GITHUB_TOKEN.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Either a path to the downloaded .pem ...
GITHUB_APP_PRIVATE_KEY_PATH=
# ... or the key on one line with literal \n and no quotes (Docker):
# GITHUB_APP_PRIVATE_KEY=
# Where the browser returns after connecting (the React app)
FRONTEND_URL=http://localhost:5173
