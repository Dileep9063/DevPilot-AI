# Copy to .env (never commit .env). Used by docker-compose.yml.

# --- required ---
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# At least one LLM provider key. Providers are tried in LLM_PROVIDER_ORDER
# and fall back automatically on rate limits / outages.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
# LLM_PROVIDER_ORDER=openrouter,gemini,huggingface
# Local development runs synchronously unless Redis/Celery are configured.
# DEVPILOT_ASYNC_RUNS=False
# CELERY_BROKER_URL=redis://localhost:6379/0

# Fine-grained token: Contents (read/write) + Pull requests (read/write)
GITHUB_TOKEN=

# --- production URLs (change when deploying to a real domain) ---
# VITE_API_URL is baked into the frontend at build time; it must be
# reachable from the user's BROWSER.
VITE_API_URL=http://localhost:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# CSRF_TRUSTED_ORIGINS=https://devpilot.example.com

# --- GitHub App mode (optional; see docs/GITHUB_APP_SETUP.md) ---
# When all of these are set, each user connects their own GitHub account and
# tokens are scoped per repository. Docker Compose disables the shared token
# fallback by default. For a trusted single-user self-hosted instance only,
# explicitly set DEVPILOT_ALLOW_SHARED_GITHUB_TOKEN=True in the service environment.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Either a path to the downloaded .pem ...
GITHUB_APP_PRIVATE_KEY_PATH=
# ... or the key on one line with literal \n and no quotes (Docker):
# GITHUB_APP_PRIVATE_KEY=
# Where the browser returns after connecting (the React app)
FRONTEND_URL=http://localhost:8080

# Repository test execution: Docker Compose uses bubblewrap isolation.
# For trusted local-only development outside Compose, explicitly set:
# DEVPILOT_TEST_SANDBOX=unsafe-local
# DEVPILOT_TEST_SANDBOX=bubblewrap requires bubblewrap + prlimit on Linux.
# Optional estimated token costs (USD per 1 million tokens; set rates from provider pricing):
# LLM_COST_OPENROUTER_INPUT_PER_1M=0
# LLM_COST_OPENROUTER_OUTPUT_PER_1M=0
# LLM_COST_GEMINI_INPUT_PER_1M=0
# LLM_COST_GEMINI_OUTPUT_PER_1M=0
# LLM_COST_HUGGINGFACE_INPUT_PER_1M=0
# LLM_COST_HUGGINGFACE_OUTPUT_PER_1M=0

# Best-effort workspace growth limits monitored during test/build commands.
# These are not kernel-enforced disk quotas; Bubblewrap per-file limit is separate.
DEVPILOT_TEST_MAX_WORKSPACE_BYTES=524288000
DEVPILOT_TEST_MAX_WORKSPACE_FILES=50000
# Bubblewrap temporary filesystems are bounded separately (64 MiB–2 GiB).
DEVPILOT_TEST_TMPFS_BYTES=536870912
